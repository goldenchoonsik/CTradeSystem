{
 "title": "글로벌 탑다운 관계 원장 — 노드와 선언 엣지(대응표)",
 "version": 1.2,
 "fixed_at": "2026-10-22",
 "rules": [
  "코드는 이 파일만 읽는다(대응표 하드코딩 → 테스트 실패). 바꾸면 valid_to 로 닫고 새 엣지를 valid_from 으로 열며 reason 을 적는다(지우지 않는다).",
  "사전등록 결과의 해시 대상: 2026-10-22 이전은 코드 파일(kr_industry·trade·eu_imports·reading·stocks·kr_ksic), 이후는 이 파일. 값은 그날 코드와 동일(테스트 fixture 로 고정).",
  "선언 엣지(여기)는 '무엇이 무엇에 대응하는가'이고, 측정 엣지(연결 강도·비중·점유·베타)는 derived/ 산출물이다 — 섞지 않는다.",
  "2026-10-22 v1.1: sector_isic 추가(TiVA 산업×상대국 부가가치 노출용, 전진 트랙 V). 기존 사전등록의 원장 해시 줄은 v1.0 기준으로 그대로 둔다 — 그 검정들은 sector_isic 을 쓰지 않았다.",
  "2026-10-23 v1.2: sector_ebsi(무역협회 EBSI 품목)·sector_bsi(한국은행 업종별 수출전망 BSI) 추가 — 업종 단위 수출 전망 원천(kr_outlook). hs = 업종 안에서 그 품목이 맡는 HS 접두(가중치 = 전년 세계 수출액), 'rest' = 업종의 나머지 전부. 기존 검정들은 이 두 종류를 쓰지 않았다."
 ],
 "edge_types": {
  "country_tiva": {
   "from": "country",
   "to": "tiva_code",
   "desc": "ECOS 상대국 코드 → OECD TiVA 국가 코드(부가가치 노출)"
  },
  "country_cli": {
   "from": "country",
   "to": "fred_series",
   "desc": "상대국 → OECD 경기선행지수 FRED id(없으면 가중 합성에서 빠짐)"
  },
  "aggregate_cli": {
   "from": "tiva_aggregate",
   "to": "fred_series",
   "desc": "TiVA 집계/추가 국가 → 선행지수 FRED id"
  },
  "group_member": {
   "from": "group",
   "to": "country",
   "attrs": {
    "scope": "reading(판독 엔진 R1~R5) | links(관계판 연결 강도) | share(관계판 수출 비중)"
   },
   "desc": "상대국 그룹 구성원"
  },
  "group_cli": {
   "from": "group",
   "to": "tiva_code",
   "desc": "그룹의 경기 대리 선행지수 국가(partner_cli 열)"
  },
  "sector_kf49": {
   "from": "kr_sector",
   "to": "kf49",
   "desc": "코스피 업종 → Ken French 49업종"
  },
  "sector_us_ip": {
   "from": "kr_sector",
   "to": "us_ip",
   "desc": "코스피 업종 → FRED 업종 산업생산(industry.FUND_MAP 키)"
  },
  "sector_ksic": {
   "from": "kr_sector",
   "to": "ksic2",
   "desc": "코스피 업종 → KSIC 2자리(KOSIS 생산지수·DART 종목 분류)"
  },
  "sector_hs": {
   "from": "kr_sector",
   "to": "hs_prefix",
   "attrs": {
    "mode": "include | exclude(제외분은 다른 업종의 include 로 간다)"
   },
   "desc": "코스피 업종 → 한국 수출 품목 HS 접두(관세청)"
  },
  "sector_product": {
   "from": "kr_sector",
   "to": "product",
   "desc": "코스피 업종 → 미국·EU 수입 경쟁 품목(product 노드)"
  },
  "market_partner": {
   "from": "import_market",
   "to": "market_code",
   "attrs": {
    "name": "표시 이름"
   },
   "desc": "수입 시장별 상대국 코드('-' = 전체/역외 전체)"
  },
  "sector_isic": {
   "from": "kr_sector",
   "to": "isic_activity",
   "desc": "코스피 업종 → OECD TiVA(ISIC rev4) 산업 코드 — 부가가치 기준 노출(FFD_DVA). KSIC 와 ISIC 는 2자리 번호가 다르다(KSIC C27 의료정밀 ≠ ISIC C27 전기장비)"
  },
  "sector_ebsi": {
   "from": "kr_sector",
   "to": "ebsi_item",
   "desc": "코스피 업종 → 무역협회 수출산업경기전망지수(EBSI) 품목(KOSIS 360/DT_36005_A001). hs = 업종 안 그 품목의 HS 접두 목록 또는 'rest'(나머지 전부) — 업종 EBSI = 그 분기에 값이 있는 품목을 전년 세계 수출액으로 가중 평균"
  },
  "sector_bsi": {
   "from": "kr_sector",
   "to": "bsi_industry",
   "desc": "코스피 업종 → 한국은행 업종별 기업경기실사지수 수출전망(ECOS 512Y008, BSI코드 BM) 업종. hs 규칙은 sector_ebsi 와 같다"
  }
 },
